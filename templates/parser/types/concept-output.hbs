<h3>{{ item.name }}</h3>

<dl>
	<dt>Type</dt>
	<dd>{{ item.type }}</dd>
	{{#if related.length}}
		<dt>Related Features</dt>
		{{#each related}}
			<dd>
				<strong>{{ name }}</strong>
				{{#if system.description.value}}
					<div class="related-feature-description">{{{ system.description.value }}}</div>
				{{/if}}
			</dd>
		{{/each}}
	{{/if}}
</dl>

<hr>

{{{ enriched.description }}}
